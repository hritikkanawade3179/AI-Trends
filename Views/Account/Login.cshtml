@{ ViewData["Title"] = "Login"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container py-5" style="max-width:420px">
    <div class="card border-0 shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-cpu-fill text-primary display-4"></i>
                <h3 class="fw-bold mt-2">Admin Login</h3>
                <p class="text-muted small">Sign in to manage AI Trends News</p>
            </div>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" name="email" class="form-control form-control-lg" placeholder="admin@aitrendsnews.com" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required />
                </div>
                <div class="mb-4 form-check">
                    <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label small" for="rememberMe">Remember me</label>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>
            <p class="text-center text-muted small mt-4 mb-0">
                Default credentials: admin@aitrendsnews.com / Admin@123!
            </p>
        </div>
    </div>
</div>
