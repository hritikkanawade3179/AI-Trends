<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")AI Trends News</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container-xl">
        <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cpu-fill text-primary me-2"></i>AI Trends
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">News</a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index">All Updates</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index" asp-route-type="News">News Articles</a></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index" asp-route-type="Research">Research Papers</a></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index" asp-route-type="Tool">AI Tools</a></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index" asp-route-type="Video">Video Updates</a></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index" asp-route-type="Event">Events</a></li>
                    </ul>
                </li>
            </ul>
            <form class="d-flex me-3" asp-controller="News" asp-action="Index" method="get">
                <div class="input-group">
                    <input class="form-control form-control-sm bg-dark text-light border-secondary"
                           type="search" name="search" placeholder="Search AI news..." style="min-width:200px" />
                    <button class="btn btn-outline-secondary btn-sm" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-1"></i>Admin
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-sm btn-outline-light">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-lock me-1"></i>Login
                </a>
            }
        </div>
    </div>
</nav>

@if (TempData["SubscribeSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 text-center">
        @TempData["SubscribeSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<main>
    @RenderBody()
</main>

<footer class="bg-dark text-secondary py-5 mt-5">
    <div class="container-xl">
        <div class="row g-4">
            <div class="col-lg-4">
                <h5 class="text-white fw-bold"><i class="bi bi-cpu-fill text-primary me-2"></i>AI Trends News</h5>
                <p class="small">Your hub for the latest in AI — news, research papers, tools, videos and events curated for developers and engineers.</p>
                <form asp-controller="Home" asp-action="Subscribe" method="post" class="d-flex gap-2">
                    <input type="email" name="email" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="your@email.com" required />
                    <button class="btn btn-primary btn-sm">Subscribe</button>
                </form>
            </div>
            <div class="col-lg-2 col-md-4">
                <h6 class="text-white">Content</h6>
                <ul class="list-unstyled small">
                    <li><a class="text-secondary text-decoration-none" asp-controller="News" asp-action="Index" asp-route-type="News">News Articles</a></li>
                    <li><a class="text-secondary text-decoration-none" asp-controller="News" asp-action="Index" asp-route-type="Research">Research Papers</a></li>
                    <li><a class="text-secondary text-decoration-none" asp-controller="News" asp-action="Index" asp-route-type="Tool">AI Tools</a></li>
                    <li><a class="text-secondary text-decoration-none" asp-controller="News" asp-action="Index" asp-route-type="Video">Videos</a></li>
                    <li><a class="text-secondary text-decoration-none" asp-controller="News" asp-action="Index" asp-route-type="Event">Events</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-4">
                <h6 class="text-white">Platform</h6>
                <ul class="list-unstyled small">
                    <li><a class="text-secondary text-decoration-none" href="#">About</a></li>
                    <li><a class="text-secondary text-decoration-none" asp-controller="Account" asp-action="Login">Admin Login</a></li>
                </ul>
            </div>
        </div>
        <hr class="border-secondary mt-4" />
        <p class="text-center small mb-0">&copy; @DateTime.Now.Year AI Trends News. Built with .NET Core MVC.</p>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
