<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")Admin – AI Trends</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
<div class="d-flex" style="min-height:100vh">
    <!-- Sidebar -->
    <nav class="admin-sidebar d-flex flex-column p-3" style="width:240px;min-height:100vh">
        <a class="navbar-brand fw-bold text-white mb-4 text-decoration-none" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cpu-fill text-primary me-2"></i>AI Trends
        </a>
        <ul class="nav flex-column gap-1 flex-grow-1">
            <li class="nav-item">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Post") == true ? "active" : "")"
                   asp-controller="Admin" asp-action="Posts">
                    <i class="bi bi-file-earmark-text me-2"></i>Posts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")"
                   asp-controller="Admin" asp-action="Categories">
                    <i class="bi bi-folder me-2"></i>Categories
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Tags" ? "active" : "")"
                   asp-controller="Admin" asp-action="Tags">
                    <i class="bi bi-tags me-2"></i>Tags
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Subscribers" ? "active" : "")"
                   asp-controller="Admin" asp-action="Subscribers">
                    <i class="bi bi-envelope me-2"></i>Subscribers
                </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people me-2"></i>Users
                    </a>
                </li>
            }
        </ul>
        <div class="mt-auto pt-3 border-top border-secondary">
            <p class="small text-secondary mb-1">Logged in as</p>
            <p class="text-white small mb-2 fw-bold">@User.Identity?.Name</p>
            <a class="btn btn-sm btn-outline-light w-100" asp-controller="Home" asp-action="Index" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i>View Site
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                <button class="btn btn-sm btn-outline-danger w-100">
                    <i class="bi bi-box-arrow-left me-1"></i>Logout
                </button>
            </form>
        </div>
    </nav>

    <!-- Main content -->
    <div class="flex-grow-1 bg-light">
        <div class="admin-topbar bg-white border-bottom px-4 py-2 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h6>
            <div class="d-flex gap-2">
                @if (TempData["Success"] != null)
                {
                    <span class="badge bg-success py-2 px-3"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</span>
                }
                <a class="btn btn-primary btn-sm" asp-controller="Admin" asp-action="CreatePost">
                    <i class="bi bi-plus-lg me-1"></i>New Post
                </a>
            </div>
        </div>
        <div class="p-4">
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
