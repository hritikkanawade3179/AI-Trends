@model AITrendsNews.ViewModels.PostFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "EditPost" : "CreatePost";
}
<form asp-action="@action" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title *</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Post title..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">Summary</label>
                        <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Brief summary shown in listing..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Body" class="form-label fw-semibold">Body Content</label>
                        <textarea asp-for="Body" id="bodyEditor" class="form-control" rows="14"
                                  placeholder="Write full content here (HTML supported)..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ExternalUrl" class="form-label fw-semibold">External URL</label>
                        <input asp-for="ExternalUrl" class="form-control" type="url" placeholder="https://..." />
                        <div class="form-text">Link to original source (paper, tool, video, event registration)</div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="ThumbnailUrl" class="form-label fw-semibold">Thumbnail URL</label>
                        <input asp-for="ThumbnailUrl" class="form-control" type="url" placeholder="https://..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent fw-semibold pt-3">Publish</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in Enum.GetValues<AITrendsNews.Models.PostStatus>())
                            { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-semibold small">Content Type</label>
                        <select asp-for="Type" class="form-select">
                            @foreach (var t in Enum.GetValues<AITrendsNews.Models.PostType>())
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold small">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in Model.Categories)
                            { <option value="@cat.Id">@cat.Name</option> }
                        </select>
                    </div>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFeatured" class="form-check-label small">Featured</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsTrending" class="form-check-input" type="checkbox" />
                            <label asp-for="IsTrending" class="form-check-label small">Trending</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-check-lg me-1"></i>@(isEdit ? "Update Post" : "Create Post")
                    </button>
                    <a asp-action="Posts" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>

            @if (Model.AllTags.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent fw-semibold pt-3">Tags</div>
                    <div class="card-body" style="max-height:240px;overflow-y:auto">
                        @foreach (var tag in Model.AllTags)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedTagIds"
                                       value="@tag.Id" id="tag_@tag.Id"
                                       @(Model.SelectedTagIds.Contains(tag.Id) ? "checked" : "") />
                                <label class="form-check-label small" for="tag_@tag.Id">@tag.Name</label>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</form>
