@model AITrendsNews.ViewModels.PostDetailViewModel
@{ ViewData["Title"] = Model.Post.Title; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="container-xl py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="News" asp-action="Index" class="text-decoration-none">News</a></li>
                    <li class="breadcrumb-item active">@Model.Post.Title</li>
                </ol>
            </nav>

            <!-- Badges -->
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <span class="badge px-3 py-2" style="background:@(Model.Post.Category?.ColorHex ?? "#534AB7")">
                    <i class="@(Model.Post.Category?.IconClass) me-1"></i>@Model.Post.Category?.Name
                </span>
                <span class="badge bg-light text-dark border px-3 py-2">@Model.Post.Type</span>
                @if (Model.Post.IsTrending) { <span class="badge bg-danger px-3 py-2"><i class="bi bi-graph-up-arrow me-1"></i>Trending</span> }
                @if (Model.Post.IsFeatured) { <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-star-fill me-1"></i>Featured</span> }
            </div>

            <h1 class="display-5 fw-bold mb-3">@Model.Post.Title</h1>
            <p class="lead text-muted mb-4">@Model.Post.Summary</p>

            <div class="d-flex gap-4 text-muted small mb-4 border-bottom pb-3">
                <span><i class="bi bi-person-circle me-1"></i>@(Model.Post.Author?.FullName ?? "Editorial Team")</span>
                <span><i class="bi bi-calendar3 me-1"></i>@Model.Post.PublishedAt?.ToString("MMMM dd, yyyy")</span>
                <span><i class="bi bi-eye me-1"></i>@Model.Post.ViewCount views</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Post.ThumbnailUrl))
            {
                <img src="@Model.Post.ThumbnailUrl" class="img-fluid rounded-3 mb-4 w-100" style="max-height:400px;object-fit:cover" alt="@Model.Post.Title" />
            }

            @if (!string.IsNullOrEmpty(Model.Post.ExternalUrl))
            {
                <div class="alert alert-primary d-flex align-items-center gap-3 mb-4">
                    <i class="bi bi-link-45deg fs-4"></i>
                    <div>
                        <strong>External Resource</strong>
                        <div><a href="@Model.Post.ExternalUrl" target="_blank" class="text-primary">@Model.Post.ExternalUrl <i class="bi bi-box-arrow-up-right ms-1"></i></a></div>
                    </div>
                </div>
            }

            <div class="post-body fs-5 lh-lg">
                @Html.Raw(Model.Post.Body)
            </div>

            @if (Model.Post.PostTags.Any())
            {
                <div class="mt-5 pt-3 border-top">
                    <span class="fw-semibold me-2"><i class="bi bi-tags me-1"></i>Tags:</span>
                    @foreach (var pt in Model.Post.PostTags)
                    {
                        <a asp-controller="News" asp-action="Index" asp-route-tag="@pt.Tag!.Slug"
                           class="badge bg-light text-dark border text-decoration-none me-1 px-2 py-1">@pt.Tag.Name</a>
                    }
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            @if (Model.RelatedPosts.Any())
            {
                <div class="card border-0 shadow-sm sticky-top" style="top:80px">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-collection me-2 text-primary"></i>Related Posts</h6>
                        @foreach (var rp in Model.RelatedPosts)
                        {
                            <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                                <div class="flex-shrink-0 rounded-2 d-flex align-items-center justify-content-center text-white"
                                     style="width:48px;height:48px;background:@(rp.Category?.ColorHex ?? "#534AB7")">
                                    <i class="@(rp.Category?.IconClass ?? "bi bi-newspaper") small"></i>
                                </div>
                                <div>
                                    <a asp-action="Detail" asp-route-slug="@rp.Slug"
                                       class="text-decoration-none text-dark small fw-semibold lh-sm d-block">@rp.Title</a>
                                    <span class="text-muted" style="font-size:11px">@rp.PublishedAt?.ToString("MMM dd")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
